.com/s/files/1/0784/8676/5621/files/ep-line-1795871103887-14.mp3?v=1795871106","words":[{"w":"That","s":0.688,"e":0.88},{"w":"aisle","s":0.933,"e":1.2},{"w":"is","s":1.253,"e":1.36},{"w":"fine.","s":1.504,"e":2.16},{"w":"The","s":2.32,"e":2.8},{"w":"clown","s":2.88,"e":3.28},{"w":"noses","s":3.387,"e":3.92},{"w":"are","s":3.96,"e":4.08},{"w":"not.","s":4.2,"e":4.64},{"w":"Goodnight.","s":4.832,"e":6.4}]},{"who":"narrator","text":"Rosa hurries back to her desk.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795871103887-15.mp3?v=1795871107","words":[{"w":"Rosa","s":0.32,"e":0.4},{"w":"hurries","s":0.46,"e":0.8},{"w":"back","s":0.848,"e":1.04},{"w":"to","s":1.093,"e":1.2},{"w":"her","s":1.24,"e":1.36},{"w":"desk.","s":1.44,"e":1.84}]},{"who":"rosa","text":"Gerald? Buddy? Weren't you over by the window?","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795871103887-16.mp3?v=1795871107","words":[{"w":"Gerald?","s":0.96,"e":1.28},{"w":"Buddy?","s":1.467,"e":2.84},{"w":"Weren't","s":3.06,"e":3.44},{"w":"you","s":3.48,"e":3.6},{"w":"over","s":3.648,"e":3.84},{"w":"by","s":3.867,"e":3.92},{"w":"the","s":3.94,"e":4},{"w":"window?","s":4.069,"e":4.64}]},{"who":"narrator","text":"Now he stands right beside her desk. Facing her chair.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795871103887-17.mp3?v=1795871107","words":[{"w":"Now","s":0.21,"e":0.24},{"w":"he","s":0.293,"e":0.4},{"w":"stands","s":0.469,"e":0.88},{"w":"right","s":0.947,"e":1.28},{"w":"beside","s":1.337,"e":1.68},{"w":"her","s":1.72,"e":1.84},{"w":"desk.","s":1.936,"e":2.4},{"w":"Facing","s":2.537,"e":3.36},{"w":"her","s":3.4,"e":3.52},{"w":"chair.","s":3.587,"e":4.08}]},{"who":"rosa","text":"Gerald!","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795871103887-18.mp3?v=1795871106","words":[{"w":"Gerald!","s":0.52,"e":1.2}]},{"who":"rosa","text":"New hat? Very nice. Are we doing a fashion thing now?","audio":"