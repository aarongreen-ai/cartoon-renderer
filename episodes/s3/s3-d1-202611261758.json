"w":"Goodnight","s":0.864,"e":1.28},{"w":"to","s":1.307,"e":1.36},{"w":"the","s":1.38,"e":1.44},{"w":"mannequins?","s":1.52,"e":2.24},{"w":"That's","s":2.32,"e":2.72},{"w":"silly.","s":2.787,"e":3.4},{"w":"Right,","s":3.447,"e":3.76},{"w":"Gerald?","s":3.817,"e":4.24}]},{"who":"narrator","text":"The warehouse went very, very quiet.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-15.mp3?v=1795715864","words":[{"w":"The","s":0.145,"e":0.16},{"w":"warehouse","s":0.224,"e":0.8},{"w":"went","s":0.864,"e":1.12},{"w":"very,","s":1.232,"e":2.16},{"w":"very","s":2.224,"e":2.48},{"w":"quiet.","s":2.587,"e":3.12}]},{"who":"narrator","text":"Somewhere in Aisle thirteen, something clicked.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-16.mp3?v=1795715864","words":[{"w":"Somewhere","s":0.2,"e":0.56},{"w":"in","s":0.613,"e":0.72},{"w":"Aisle","s":0.8,"e":1.04},{"w":"thirteen,","s":1.129,"e":2.24},{"w":"something","s":2.28,"e":2.64},{"w":"clicked.","s":2.7,"e":3.2}]},{"who":"rosa","text":"Hello? Is someone back there?","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-17.mp3?v=1795715864","words":[{"w":"Hello?","s":0.333,"e":0.48},{"w":"Is","s":0.693,"e":1.12},{"w":"someone","s":1.15,"e":1.36},{"w":"back","s":1.408,"e":1.6},{"w":"there?","s":1.653,"e":3.04}]},{"who":"greaves","text":"Rosa! Mr. Greaves here. Have you counted the clown noses?","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-18.mp3?v=1795715864","words":[{"w":"Rosa!","s":0.538,"e":0.72},{"w":"Mr.","s":0.8,"e":1.28},{"w":"Greaves","s":1.34,"e":1.92},{"w":"here.","s":2,"e":2.4},{"w":"Have","s":2.464,"e":2.72},{"w":"you","s":2.76,"e":2.88},{"w":"counted","s":2.95,"e":3.44},{"w":"the","s":3.48,"e":3.6},{"w":"clown","s":3.68,"e":4.08},{"w":"noses?","s":4.187,"e":5.44}]},{"who":"rosa","text":"Sir, I think something is in Aisle thirteen.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-19.mp3?v=1795715864","words":[{"w":"Sir,","s":0.28,"e":0.48},{"w":"I","s":0.56,"e":0.64},{"w":"think","s":0.693,"e":0.96},{"w":"something","s":1,"e":1.36},{"w":"is","s":1.413,"e":1.52},{"w":"in","s":1.547,"e":1.6},{"w":"Aisle","s":1.68,"e":1.84},{"w":"thirteen.","s":1.92,"e":2.64}]},{"who":"greaves","text":"Splendid. Count them twice. Goodnight.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-20.mp3?v=1795715864","words":[{"w":"Splendid.","s":0.26,"e":0.96},{"w":"Count","s":1.053,"e":1.52},{"w":"them","s":1.552,"e":1.68},{"w":"twice.","s":1.813,"e":2.76},{"w":"Goodnight.","s":2.816,"e":3.68}]},{"who":"rosa","text":"Gerald, I'm borrowing your hat. For courage.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-21.mp3?v=1795715864","words":[{"w":"Gerald,","s":0.686,"e":0.88},{"w":"I'm","s":0.92,"e":1.16},{"w":"borrowing","s":1.18,"e":1.36},{"w":"your","s":1.392,"e":1.52},{"w":"hat.","s":1.6,"e":1.92},{"w":"For","s":2.12,"e":2.72},{"w":"courage.","s":2.8,"e":3.52}]},{"who":"narrator","text":"Grab the Bad Swamp Hat at Funny Hats Company. Link in bio.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-22.mp3?v=1795715864","words":[{"w":"Grab","s":0.272,"e":0.32},{"w":"the","s":0.36,"e":0.48},{"w":"Bad","s":0.58,"e":0.88},{"w":"Swamp","s":0.947,"e":1.28},{"w":"Hat","s":1.32,"e":1.44},{"w":"at","s":1.493,"e":1.6},{"w":"Funny","s":1.653,"e":1.92},{"w":"Hats","s":1.968,"e":2.16},{"w":"Company.","s":2.22,"e":2.92},{"w":"Link","s":2.976,"e":3.2},{"w":"in","s":3.28,"e":3.44},{"w":"bio.","s":3.54,"e":4.16}]},{"who":"narrator","text":"Behind her, Gerald's head turned. Just a little.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-23.mp3?v=1795715864","words":[{"w":"Behind","s":0.314,"e":0.4},{"w":"her,","s":0.44,"e":0.96},{"w":"Gerald's","s":1.006,"e":1.4},{"w":"head","s":1.424,"e":