":0.66,"e":1.04},{"w":"count","s":1.173,"e":1.84},{"w":"every","s":1.92,"e":2.32},{"w":"costume","s":2.38,"e":2.8},{"w":"inside","s":2.88,"e":3.36},{"w":"before","s":3.406,"e":3.68},{"w":"the","s":3.7,"e":3.76},{"w":"auction.","s":3.82,"e":4.32}]},{"who":"rosa","text":"It pays double. How scary can feathers be?","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-2.mp3?v=1795715864","words":[{"w":"It","s":0.069,"e":0.08},{"w":"pays","s":0.16,"e":0.48},{"w":"double.","s":0.549,"e":1.04},{"w":"How","s":1.16,"e":1.52},{"w":"scary","s":1.587,"e":1.92},{"w":"can","s":1.96,"e":2.08},{"w":"feathers","s":2.124,"e":2.48},{"w":"be?","s":2.56,"e":2.8}]},{"who":"junie","text":"Forty keys. One clipboard. Count everything. I'm leaving.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-3.mp3?v=1795715864","words":[{"w":"Forty","s":0.27,"e":0.32},{"w":"keys.","s":0.416,"e":0.88},{"w":"One","s":1,"e":1.36},{"w":"clipboard.","s":1.408,"e":1.92},{"w":"Count","s":2.053,"e":2.72},{"w":"everything.","s":2.764,"e":3.28},{"w":"I'm","s":3.68,"e":4.16},{"w":"leaving.","s":4.21,"e":4.88}]},{"who":"rosa","text":"Wait, which key opens which door?","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-4.mp3?v=1795715864","words":[{"w":"Wait,","s":0.528,"e":0.8},{"w":"which","s":0.853,"e":1.12},{"w":"key","s":1.18,"e":1.36},{"w":"opens","s":1.413,"e":1.68},{"w":"which","s":1.72,"e":1.92},{"w":"door?","s":1.984,"e":2.48}]},{"who":"junie","text":"No idea! Snacks are in the drawer! Goodbye!","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795715861355-5.mp3?v=1795715864","words":[{"w":"No","s":0.213,"e":0.24},{"w":"idea!","s":0.352,"e":0.88},{"w":"Snacks","s":0.933,"e":1.28},{"w":"are","s":1.3,"e":1.36},{"w":"in","s":1.387,"e":1.44},{"w":"the","s":1.46,"e":1.52},{"w":"drawer!","s":1.589,"e":2.08},{"w":"Goodbye!","s":2.128,"e":2.96}]},{"who":"narrator","text":"Junie's exit t