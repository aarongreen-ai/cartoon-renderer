iles/ep-line-1795784634348-1.mp3?v=1795784637","words":[{"w":"Forty","s":0.2,"e":0.24},{"w":"keys.","s":0.336,"e":0.8},{"w":"One","s":0.88,"e":1.12},{"w":"clipboard.","s":1.176,"e":1.84},{"w":"Count","s":1.92,"e":2.32},{"w":"every","s":2.373,"e":2.64},{"w":"costume","s":2.71,"e":3.2},{"w":"before","s":3.246,"e":3.52},{"w":"the","s":3.56,"e":3.68},{"w":"sale.","s":3.744,"e":4.08}]},{"who":"rosa","text":"Double pay to count feathers? How scary can feathers be?","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-2.mp3?v=1795784637","words":[{"w":"Double","s":0.265,"e":0.32},{"w":"pay","s":0.42,"e":0.72},{"w":"to","s":0.773,"e":0.88},{"w":"count","s":0.92,"e":1.12},{"w":"feathers?","s":1.191,"e":1.84},{"w":"How","s":1.92,"e":2.16},{"w":"scary","s":2.227,"e":2.56},{"w":"can","s":2.6,"e":2.72},{"w":"feathers","s":2.773,"e":3.2},{"w":"be?","s":3.28,"e":3.52}]},{"who":"junie","text":"Lock up at dawn. Don't stay late. Don't ask why.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-3.mp3?v=1795784637","words":[{"w":"Lock","s":0.272,"e":0.32},{"w":"up","s":0.373,"e":0.48},{"w":"at","s":0.507,"e":0.56},{"w":"dawn.","s":0.656,"e":1.12},{"w":"Don't","s":1.24,"e":1.68},{"w":"stay","s":1.728,"e":1.92},{"w":"late.","s":2.016,"e":2.64},{"w":"Don't","s":2.7,"e":2.96},{"w":"ask","s":3.02,"e":3.2},{"w":"why.","s":3.32,"e":4}]},{"who":"narrator","text":"Junie left in forty seconds. A new building record.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-4.mp3?v=1795784637","words":[{"w":"Junie","s":0.195,"e":0.32},{"w":"left","s":0.368,"e":0.56},{"w":"in","s":0.587,"e":0.64},{"w":"forty","s":0.707,"e":1.04},{"w":"seconds.","s":1.11,"e":1.8},{"w":"A","s":1.9,"e":2},{"w":"new","s":2.06,"e":2.24},{"w":"building","s":2.284,"e":2.64},{"w":"record.","s":2.697,"e":3.28}]},{"who":"narrator","text":"Inside, the showroom smelled like dust, mothballs and old applause.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-5.mp3?v=1795784637","words":[{"w":"Inside,","s":0.53,"e":0.88},{"w":"the","s":0.9,"e":0.96},{"w":"showroom","s":1.022,"e":1.52},{"w":"smelled","s":1.57,"e":1.92},{"w":"like","s":1.952,"e":2.08},{"w":"dust,","s":2.192,"e":2.96},{"w":"mothballs","s":3.04,"e":3.76},{"w":"and","s":3.88,"e":4.24},{"w":"old","s":4.3,"e":4.48},{"w":"applause.","s":4.551,"e":5.2}]},{"who":"rosa","text":"And who are you? You look like a Gerald.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-6.mp3?v=1795784637","words":[{"w":"And","s":0.195,"e":0.24},{"w":"who","s":0.28,"e":0.4},{"w":"are","s":0.46,"e":0.64},{"w":"you?","s":0.7,"e":1.2},{"w":"You","s":1.28,"e":1.52},{"w":"look","s":1.552,"e":1.68},{"w":"like","s":1.712,"e":1.84},{"w":"a","s":1.88,"e":1.92},{"w":"Gerald.","s":2,"e":2.56}]},{"who":"narrator","text":"The mannequin did not answer. That was the good news.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-7.mp3?v=1795784637","words":[{"w":"The","s":0.14,"e":0.16},{"w":"mannequin","s":0.2,"e":0.64},{"w":"did","s":0.68,"e":0.8},{"w":"not","s":0.86,"e":1.04},{"w":"answer.","s":1.086,"e":1.44},{"w":"That","s":1.648,"e":2.48},{"w":"was","s":2.52,"e":2.64},{"w":"the","s":2.68,"e":2.8},{"w":"good","s":2.832,"e":2.96},{"w":"news.","s":3.024,"e":3.36}]},{"who":"rosa","text":"Wait. Something is taped to the desk.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-8.mp3?v=1795784637","words":[{"w":"Wait.","s":0.315,"e":0.48},{"w":"Something","s":0.56,"e":1.28},{"w":"is","s":1.36,"e":1.52},{"w":"taped","s":1.587,"e":1.92},{"w":"to","s":1.947,"e":2},{"w":"the","s":2.04,"e":2.16},{"w":"desk.","s":2.272,"e":2.88}]},{"who":"narrator","text":"A notebook. Lionel, night clerk. Read before midnight.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-9.mp3?v=1795784637","words":[{"w":"A","s":0.072,"e":0.08},{"w":"notebook.","s":0.142,"e":0.72},{"w":"Lionel,","s":0.994,"e":2.72},{"w":"night","s":2.773,"e":3.04},{"w":"clerk.","s":3.107,"e":3.84},{"w":"Read","s":3.92,"e":4.24},{"w":"before","s":4.286,"e":4.56},{"w":"midnight.","s":4.622,"e":6}]},{"who":"rosa","text":"Page one. The rules keep you safe. Follow them in order.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-10.mp3?v=1795784637","words":[{"w":"Page","s":0.192,"e":0.24},{"w":"one.","s":0.32,"e":0.64},{"w":"The","s":0.74,"e":1.04},{"w":"rules","s":1.107,"e":1.44},{"w":"keep","s":1.488,"e":1.68},{"w":"you","s":1.72,"e":1.84},{"w":"safe.","s":1.936,"e":2.72},{"w":"Follow","s":2.777,"e":3.12},{"w":"them","s":3.168,"e":3.36},{"w":"in","s":3.467,"e":3.68},{"w":"order.","s":3.747,"e":4.24}]},{"who":"narrator","text":"Then, from the back, came a sound. Click. Click. Click.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-11.mp3?v=1795784637","words":[{"w":"Then,","s":0.269,"e":0.72},{"w":"from","s":0.752,"e":0.88},{"w":"the","s":0.92,"e":1.04},{"w":"back,","s":1.12,"e":1.52},{"w":"came","s":1.568,"e":1.76},{"w":"a","s":1.8,"e":1.84},{"w":"sound.","s":1.92,"e":2.4},{"w":"Click.","s":2.64,"e":4.56},{"w":"Click.","s":4.68,"e":5.36},{"w":"Click.","s":5.587,"e":6.88}]},{"who":"rosa","text":"Hello? Is someone there?","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-12.mp3?v=1795784637","words":[{"w":"Hello?","s":0.333,"e":0.84},{"w":"Is","s":0.987,"e":1.28},{"w":"someone","s":1.32,"e":1.6},{"w":"there?","s":1.653,"e":2}]},{"who":"greaves","text":"Rosa! Greaves here. Have you counted the clown noses?","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-13.mp3?v=1795784637","words":[{"w":"Rosa!","s":0.608,"e":1.2},{"w":"Greaves","s":1.3,"e":1.92},{"w":"here.","s":2,"e":2.64},{"w":"Have","s":2.704,"e":2.96},{"w":"you","s":2.98,"e":3.04},{"w":"counted","s":3.11,"e":3.6},{"w":"the","s":3.62,"e":3.68},{"w":"clown","s":3.76,"e":4.16},{"w":"noses?","s":4.267,"e":5.2}]},{"who":"rosa","text":"Mister Greaves, I heard clicking in the back.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-14.mp3?v=1795784637","words":[{"w":"Mister","s":0.126,"e":0.4},{"w":"Greaves,","s":0.46,"e":1.04},{"w":"I","s":1.12,"e":1.2},{"w":"heard","s":1.24,"e":1.44},{"w":"clicking","s":1.493,"e":1.92},{"w":"in","s":1.947,"e":2},{"w":"the","s":2.02,"e":2.08},{"w":"back.","s":2.16,"e":2.56}]},{"who":"greaves","text":"Clicking is not inventory. Clown noses, please. Every single one.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-15.mp3?v=1795784637","words":[{"w":"Clicking","s":0.12,"e":0.48},{"w":"is","s":0.56,"e":0.72},{"w":"not","s":0.78,"e":0.96},{"w":"inventory.","s":1.048,"e":1.92},{"w":"Clown","s":2.04,"e":2.64},{"w":"noses,","s":2.72,"e":3.36},{"w":"please.","s":3.394,"e":3.68},{"w":"Every","s":3.8,"e":4.4},{"w":"single","s":4.48,"e":4.96},{"w":"one.","s":5.06,"e":5.92}]},{"who":"greaves","text":"And Rosa? Stay out of aisle thirteen.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-16.mp3?v=1795784637","words":[{"w":"And","s":0.204,"e":0.24},{"w":"Rosa?","s":0.368,"e":0.96},{"w":"Stay","s":1.2,"e":2.16},{"w":"out","s":2.24,"e":2.48},{"w":"of","s":2.533,"e":2.64},{"w":"aisle","s":2.707,"e":3.04},{"w":"thirteen.","s":3.173,"e":4.72}]},{"who":"narrator","text":"The call dropped. Rosa looked over at Gerald.","audio":"https://cdn.shopify.com/s/files/1/0784/8676/5621/files/ep-line-1795784634348-17.mp3?v=1795784637","words":[{"w":"The","s":0.14,"e":0.16},{"w":"call","s":0.208,"e":0.4},{"w":"dropped.","s":0.46,"e":1.6},{"w":"Rosa","s":1.744,"e":2.32},{"w":"looked","s":2.354,"e":2.56},{"w":"over","s":2.592,"e":2.72},{"w":"at","s":2.773,"e":2.88},{"w":"Gerald.","s":2.937,"e":3.44}]},{"who":"rosa","text":"Gerald? You were by the window.","audio":"https: